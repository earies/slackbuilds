#!/bin/sh
#
# Rasdaemon startup script for Slackware Linux
#
# rasdaemon also logs its startup messages to syslog, so console output is
# discarded here to keep boot quiet.

BASE=rasdaemon

RASDAEMON=/usr/bin/${BASE}

# Check if rasdaemon is present.
if [ ! -x "${RASDAEMON}" ]; then
  echo "${RASDAEMON} not present or not executable"
  exit 1
fi

rasdaemon_start() {
  echo "Starting ${BASE}"
  "${RASDAEMON}" -r > /dev/null 2>&1 || echo "${BASE}: failed to start"
  "${RASDAEMON}" --enable > /dev/null 2>&1 || echo "${BASE}: failed to enable events"
}

rasdaemon_stop() {
  echo "Stopping ${BASE}"
  "${RASDAEMON}" --disable > /dev/null 2>&1
  pid=$(pidof -x "${BASE}")
  if [ -n "${pid}" ]; then
    # shellcheck disable=SC2086 # pidof may return several PIDs
    kill ${pid}
  fi
}

rasdaemon_restart() {
  rasdaemon_stop
  sleep 1
  rasdaemon_start
}

rasdaemon_status() {
  if pidof -x "${BASE}" > /dev/null; then
    echo "Status of ${BASE}: running"
  else
    echo "Status of ${BASE}: stopped"
  fi
}

case "$1" in
  'start')
    rasdaemon_start
    ;;
  'stop')
    rasdaemon_stop
    ;;
  'restart')
    rasdaemon_restart
    ;;
  'status')
    rasdaemon_status
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|status}"
esac

exit 0
