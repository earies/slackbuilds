+// both modes show the same abbreviation instead of the grid showing the untruncated
+// locale default.
+Glib::ustring weekdayAbbrev2(const weekday& wd, const std::locale& locale) {
+  Glib::ustring wdStr = date::format(locale, "{:L%a}", wd);
+  auto wdLen = wdStr.length();
+  auto clen = ustring_clen(wdStr);
+  while (clen > 2) {
+    wdStr = wdStr.substr(0, wdLen - 1);
+    --wdLen;
+    clen = ustring_clen(wdStr);
+  }
+  return wdStr;
