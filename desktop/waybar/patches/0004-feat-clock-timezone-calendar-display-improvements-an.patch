+auto waybar::modules::Clock::updateTzGrid(sys_seconds now, const year_month_day& today) -> void {
+  if (tzList_.size() == 1) return;
+
+  std::vector<size_t> visible;
+  for (size_t tz_idx{0}; tz_idx < tzList_.size(); ++tz_idx) {
+    // Skip local timezone (nullptr) - never show it in tooltip
+    if (tzList_[tz_idx] == nullptr) continue;
+    // Skip current timezone unless timezone-tooltip-format is specified
+    if (static_cast<int>(tz_idx) == tzCurrIdx_ && tzTooltipFormats_.empty()) continue;
+    visible.push_back(tz_idx);
+  }
+
+  // 0 or 1 configured formats keeps the original single time-column layout (and its
+  // .clock-timezone-time class, for backward CSS compatibility); 2+ formats gives each
+  // its own column so e.g. a variable-width {:%Z} doesn't ragged-align its neighbors.
+  const size_t numTimeCols = std::max<size_t>(1, tzTooltipFormats_.size());
+
+  if (visible.size() != m_tzRows_.size()) {
+    // Shape changed (timezone cycled in/out of view). Rare -- only happens on an explicit
+    // tz_up/tz_down action, which forces a requery afterwards, so rebuilding here doesn't
+    // reintroduce per-tick popup churn.
+    for (auto* child : m_tzGrid_->get_children()) m_tzGrid_->remove(*child);
+    m_tzRows_.clear();
+    for (size_t row = 0; row < visible.size(); ++row) {
+      std::vector<Glib::RefPtr<Gtk::Label>> cells;
+
+      auto labelCell = Glib::RefPtr<Gtk::Label>(new Gtk::Label());
+      labelCell->get_style_context()->add_class("clock-timezone-label");
+      labelCell->set_halign(Gtk::ALIGN_START);
+      m_tzGrid_->attach(*labelCell.get(), 0, row, 1, 1);
+      cells.push_back(labelCell);
+
+      for (size_t col = 0; col < numTimeCols; ++col) {
+        auto timeCell = Glib::RefPtr<Gtk::Label>(new Gtk::Label());
+        timeCell->get_style_context()->add_class("clock-timezone-time");
+        if (tzTooltipFormats_.size() > 1)
+          timeCell->get_style_context()->add_class("clock-timezone-col-" + std::to_string(col));
+        timeCell->set_halign(Gtk::ALIGN_START);
+        m_tzGrid_->attach(*timeCell.get(), static_cast<int>(col + 1), row, 1, 1);
+        cells.push_back(timeCell);
+      }
+
+      m_tzRows_.push_back(std::move(cells));
+    }
+    m_tzGrid_->show_all();
+  }
+
+  for (size_t row = 0; row < visible.size(); ++row) {
+    const size_t tz_idx = visible[row];
+    const auto* tz = tzList_[tz_idx];
+    const auto zt{zoned_time{tz, now}};
+    const std::string label =
+        tzLabels_[tz_idx].empty() ? std::string(tz->name()) : tzLabels_[tz_idx];
+    m_tzRows_[row][0]->set_text(label);
+
+    for (size_t col = 0; col < numTimeCols; ++col) {
+      const std::string& fmt = tzTooltipFormats_.empty() ? format_ : tzTooltipFormats_[col];
+      try {
+        m_tzRows_[row][col + 1]->set_text(
+            fmt_lib::vformat(m_locale_, fmt, fmt_lib::make_format_args(zt)));
+      } catch (const std::exception& e) {
+        m_tzRows_[row][col + 1]->set_text("");
+      }
+    }
+
+    // Highlight rows whose local calendar date differs from today's, so a timezone
+    // that's crossed into the next/previous day stands out from the rest of the list.
+    const year_month_day zoneDay{floor<days>(zt.get_local_time())};
+    const bool ahead = zoneDay > today;
+    const bool behind = zoneDay < today;
+    for (auto& cell : m_tzRows_[row]) {
+      auto ctx = cell->get_style_context();
+      if (ahead)
+        ctx->add_class("clock-timezone-day-ahead");
+      else
+        ctx->remove_class("clock-timezone-day-ahead");
+      if (behind)
+        ctx->add_class("clock-timezone-day-behind");
+      else
+        ctx->remove_class("clock-timezone-day-behind");
+    }
+  }
+}
