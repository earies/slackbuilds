+		"Europe/Paris"
+	],
+	"tooltip": true,
+	"tooltip-format": "{tz_list}"
+}
+```
+
+6. Timezones as a CSS-styled grid instead of padded text
+
+```
+"clock": {
+	"interval": 60,
+	"format": "{:%H:%M}",
+	"native-tooltip": true,
+	"timezone-column-spacing": 12,
+	"timezones": [
+		"",
+		{ "zone": "America/Denver", "label": "Denver" },
+		{ "zone": "America/Los_Angeles", "label": "LA" }
+	],
+	"tooltip": true,
+	"tooltip-format": "{tz_list}"
+}
+```
+
+Then in *style.css*:
+
+```
+.clock-timezone-label {
+	font-family: "Liberation Sans";
+	font-weight: bold;
+}
+```
+
+7. Timezones with a variable-width field split into its own column
+
+A single *timezone-tooltip-format* string puts the whole formatted time in one
+cell, so a field like *{:%Z}* (whose width varies, e.g. *MST* vs *PDT* vs
+*IST*) ragged-aligns whatever comes after it. Splitting the format into a list
+gives each field its own grid column instead, so only that column's width
+varies -- everything else still lines up:
+
+```
+"clock": {
+	"native-tooltip": true,
+	"timezone-tooltip-format": [
+		"{:%Y-%m-%d}",
+		"{:%T}",
+		"{:%Z}"
+	],
+	"timezones": [
+		"",
+		"America/Denver",
+		"Asia/Calcutta"
+	],
+	"tooltip": true,
+	"tooltip-format": "{tz_list}"
+}
+```
+
+```
+.clock-timezone-col-2 {
+	color: #999999;
+}
+```
+
+8. Calendar (month mode) and timezones, both as CSS-styled native grids
+
+```
+"clock": {
+	"interval": 60,
+	"format": "{:%H:%M}",
+	"native-tooltip": true,
+	"tooltip": true,
+	"tooltip-format": "{calendar}\n\n{tz_list}",
+	"timezones": [
+		"",
+		{ "zone": "America/Denver", "label": "Denver" }
+	],
+	"calendar": {
+		"mode": "month",
+		"weeks-pos": "right"
+	}
+}
+```
+
+Note there's no *<span>* wrapping *{calendar}* or *{tz_list}* here -- with
+*native-tooltip* enabled, that styling belongs in *style.css* instead, since a
+*<span>* wrapped around either placeholder would otherwise get split apart by
+the grid taking that placeholder's place:
+
+```
+.clock-calendar-months {
+	font-family: "Liberation Sans";
+	font-weight: bold;
+}
+.clock-calendar-today {
+	color: #ff6699;
+	text-decoration: underline;
+}
+```
+
