+namespace {
+// "timezone-tooltip-format" may be a single string (historical behavior) or an
+// array of strings, one per native-grid column.
+std::vector<std::string> parseTzTooltipFormats(const Json::Value& config) {
+  const auto& v = config["timezone-tooltip-format"];
+  std::vector<std::string> out;
+  if (v.isString()) {
+    out.push_back(v.asString());
+  } else if (v.isArray()) {
+    for (const auto& entry : v) {
+      if (entry.isString()) out.push_back(entry.asString());
+    }
+  }
+  return out;
+}
+}  // namespace
+
+auto waybar::modules::Clock::addTimezoneEntry(const Json::Value& entry) -> void {
+  std::string zone_name;
+  std::string label;
+
+  if (entry.isString()) {
+    zone_name = entry.asString();
+  } else if (entry.isObject()) {
+    if (!entry["zone"].isString()) {
+      spdlog::warn("Clock timezone entry is missing a string \"zone\" field. Skipping.");
+      return;
+    }
+    zone_name = entry["zone"].asString();
+    if (entry["label"].isString()) label = entry["label"].asString();
+  } else {
+    spdlog::warn("Clock timezone entry must be a string or an object. Skipping.");
+    return;
+  }
+
+  if (zone_name.empty()) {
+    // local time should be shown
+    tzList_.push_back(nullptr);
+    tzLabels_.push_back(label);
+    return;
+  }
+
+  try {
+    tzList_.push_back(locate_zone(zone_name));
+    tzLabels_.push_back(label);
+  } catch (const std::exception& e) {
+    spdlog::warn("Timezone: {0}. {1}", zone_name, e.what());
+  }
+}
+
