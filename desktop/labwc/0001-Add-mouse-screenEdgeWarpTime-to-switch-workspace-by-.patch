diff --git a/src/edge-warp.c b/src/edge-warp.c
new file mode 100644
index 00000000..108106da
--- /dev/null
+++ b/src/edge-warp.c
@@ -0,0 +1,159 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include "edge-warp.h"
+#include <wayland-server-core.h>
+#include <wlr/types/wlr_cursor.h>
+#include <wlr/types/wlr_output_layout.h>
+#include "config/rcxml.h"
+#include "labwc.h"
+#include "output.h"
+#include "view.h"
+#include "workspaces.h"
+
+static struct {
+	struct wl_event_source *timer;
+	/* LAB_EDGE_LEFT, LAB_EDGE_RIGHT or LAB_EDGE_NONE */
+	enum lab_edge edge;
+} state;
+
+bool
+edge_warp_owns_edge(struct output *output, enum lab_edge edge,
+		double cursor_x, double cursor_y)
+{
+	if (rc.screen_edge_warp_time <= 0) {
+		return false;
+	}
+	if (edge != LAB_EDGE_LEFT && edge != LAB_EDGE_RIGHT) {
+		return false;
+	}
+	/* Only outer edges, not edges shared with another output */
+	return !wlr_output_layout_adjacent_output(server.output_layout,
+		(enum wlr_direction)edge, output->wlr_output,
+		cursor_x, cursor_y);
+}
+
+/* Returns the outer edge the cursor is touching, or LAB_EDGE_NONE */
+static enum lab_edge
+edge_at_cursor(struct output **dest_output)
+{
+	struct output *output = output_nearest_to_cursor();
+	if (!output_is_usable(output)) {
+		return LAB_EDGE_NONE;
+	}
+	*dest_output = output;
+
+	struct wlr_box box;
+	wlr_output_layout_get_box(server.output_layout, output->wlr_output,
+		&box);
+	double x = server.seat.cursor->x;
+	double y = server.seat.cursor->y;
+
+	enum lab_edge edge = LAB_EDGE_NONE;
+	if (x < box.x + 1) {
+		edge = LAB_EDGE_LEFT;
+	} else if (x >= box.x + box.width - 1) {
+		edge = LAB_EDGE_RIGHT;
+	}
+	if (edge == LAB_EDGE_NONE
+			|| !edge_warp_owns_edge(output, edge, x, y)) {
+		return LAB_EDGE_NONE;
+	}
+	return edge;
+}
+
+/* Move the cursor (and the grabbed view with it) to the opposite edge */
+static void
+warp_cursor(struct output *output, enum lab_edge edge)
+{
+	struct wlr_box box;
+	wlr_output_layout_get_box(server.output_layout, output->wlr_output,
+		&box);
+
+	double old_x = server.seat.cursor->x;
+	double y = server.seat.cursor->y;
+	/* Land 1px outside the opposite warp zone */
+	double new_x = edge == LAB_EDGE_LEFT
+		? box.x + box.width - 2 : box.x + 1;
+
+	if (!wlr_cursor_warp(server.seat.cursor, NULL, new_x, y)) {
+		return;
+	}
+
+	/*
+	 * process_cursor_move() derives the view position from the cursor
+	 * delta, so the grab stays consistent. Move the view now so it
+	 * does not lag behind until the next motion event.
+	 */
+	struct view *view = server.grabbed_view;
+	if (view) {
+		int dx = (int)(server.seat.cursor->x - old_x);
+		view_move(view, view->current.x + dx, view->current.y);
+	}
+}
+
+static int
+handle_timeout(void *data)
+{
+	struct output *output = NULL;
+	enum lab_edge edge = edge_at_cursor(&output);
+	if (!server.grabbed_view || edge == LAB_EDGE_NONE
+			|| edge != state.edge) {
+		edge_warp_finish();
+		return 0;
+	}
+
+	struct workspace *target = workspaces_find(server.workspaces.current,
+		edge == LAB_EDGE_LEFT ? "left" : "right", /*wrap*/ true);
+	if (!target || target == server.workspaces.current) {
+		edge_warp_finish();
+		return 0;
+	}
+
+	/* The grabbed view follows the workspace switch */
+	workspaces_switch_to(target, /*update_focus*/ false);
+
+	if (rc.screen_edge_warp_mouse) {
+		warp_cursor(output, edge);
+		edge_warp_finish();
+	} else {
+		/* Still at the edge: keep flipping while held */
+		wl_event_source_timer_update(state.timer,
+			rc.screen_edge_warp_time);
+	}
+	return 0;
+}
+
+void
+edge_warp_update(void)
+{
+	if (rc.screen_edge_warp_time <= 0 || !server.grabbed_view) {
+		return;
+	}
+
+	struct output *output = NULL;
+	enum lab_edge edge = edge_at_cursor(&output);
+	if (edge == LAB_EDGE_NONE) {
+		edge_warp_finish();
+		return;
+	}
+	if (edge == state.edge) {
+		/* Already armed for this edge */
+		return;
+	}
+
+	state.edge = edge;
+	if (!state.timer) {
+		state.timer = wl_event_loop_add_timer(server.wl_event_loop,
+			handle_timeout, NULL);
+	}
+	wl_event_source_timer_update(state.timer, rc.screen_edge_warp_time);
+}
+
+void
+edge_warp_finish(void)
+{
+	if (state.timer) {
+		wl_event_source_remove(state.timer);
+	}
+	state.timer = NULL;
+	state.edge = LAB_EDGE_NONE;
+}
