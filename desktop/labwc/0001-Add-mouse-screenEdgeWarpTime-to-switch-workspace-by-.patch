diff --git a/include/edge-warp.h b/include/edge-warp.h
new file mode 100644
index 00000000..a891411e
--- /dev/null
+++ b/include/edge-warp.h
@@ -0,0 +1,25 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef LABWC_EDGE_WARP_H
+#define LABWC_EDGE_WARP_H
+
+#include <stdbool.h>
+#include "common/edge.h"
+
+struct output;
+
+/*
+ * Switch workspace when a window is dragged to the left/right edge of the
+ * output layout and held there for <mouse><screenEdgeWarpTime> ms.
+ */
+
+/* Returns true if edge-warp is configured for this output edge */
+bool edge_warp_owns_edge(struct output *output, enum lab_edge edge,
+	double cursor_x, double cursor_y);
+
+/* Arm, keep or cancel the warp timer based on cursor position */
+void edge_warp_update(void);
+
+/* Cancel any pending warp */
+void edge_warp_finish(void);
+
+#endif /* LABWC_EDGE_WARP_H */
